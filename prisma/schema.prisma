// ============================================================
// SCHEMA DE BASE DE DATOS - App de Gestión de Pasajes Corporativos
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  SUPER_ADMIN
  ADMIN_TH
  COORDINADOR
  COLABORADOR
  NOMINA
  JEFE
}

enum EstadoColaborador {
  ACTIVO
  INACTIVO
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  REVISADO
  RECHAZADA
  PAGADA
}

model Empresa {
  id           String            @id @default(cuid())
  // Correlativo numérico (1, 2, 3...) solo para mostrar y contar cuántas
  // se han creado — el id real sigue siendo el cuid de arriba.
  numero       Int               @unique @default(autoincrement())
  nombre       String
  ruc          String?           @unique
  activo       Boolean           @default(true)
  // Número de WhatsApp de TH para el botón de contacto del colaborador
  // (formato libre, ej. 593987654321). Opcional: si un Sitio/Área tiene
  // el suyo propio, ese gana (ver lib/whatsappTH.ts).
  whatsapp     String?
  createdAt    DateTime          @default(now())
  sitios       SitioProductivo[]
  rutas        Ruta[]
  asignaciones AsignacionTH[]
}

model SitioProductivo {
  id            String        @id @default(cuid())
  nombre        String
  direccion     String?
  // Ver Empresa.whatsapp — si no está seteado acá, se usa el de la Empresa.
  whatsapp      String?
  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  empresaId     String
  areas         Area[]
  colaboradores Colaborador[]
  rutas         Ruta[]
  asignaciones  AsignacionTH[]

  @@index([empresaId])
}

model Area {
  id            String        @id @default(cuid())
  nombre        String
  // Ver Empresa.whatsapp — si no está seteado acá, se usa el del Sitio.
  whatsapp      String?
  sitio         SitioProductivo @relation(fields: [sitioId], references: [id])
  sitioId       String
  colaboradores Colaborador[]
  rutas         Ruta[]
  asignaciones  AsignacionTH[]

  @@index([sitioId])
}

model Ruta {
  id        String   @id @default(cuid())
  numero    Int      @unique @default(autoincrement())
  nombre    String   @default("Ruta sin nombre") // ej: "El Yaznán - Cayambe - Tabacundo"
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String
  sitio     SitioProductivo @relation(fields: [sitioId], references: [id])
  sitioId   String
  area      Area     @relation(fields: [areaId], references: [id])
  areaId    String
  valor     Decimal  @db.Decimal(10, 2)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Si está vacío, la ruta es de toda el área (como siempre). Si tiene
  // colaboradores, esa ruta puntual solo la ven ellos, no el resto del área
  // — puede haber más de uno (ej. viven en el mismo sector y comparten ruta).
  colaboradoresExclusivos Colaborador[] @relation("RutaExclusiva")

  solicitudes SolicitudPasaje[]
  colaboradoresConEstaRutaHabitual Colaborador[] @relation("RutaHabitual")

  @@unique([areaId, nombre]) // evita 2 rutas con el mismo nombre en la misma área
  @@index([sitioId, areaId, activo])
  // El índice de arriba tiene sitioId primero, así que no sirve para
  // filtros que buscan solo por área o solo por empresa (sin sitio) — y
  // eso es justo lo que hacen las pantallas de TH y el alcance por
  // Empresa/Sitio/Área de obtenerCondicionRutaTH (lib/alcanceTH.ts).
  @@index([areaId, activo])
  @@index([empresaId])
}

model Usuario {
  id           String        @id @default(cuid())
  numero       Int           @unique @default(autoincrement())
  nombre       String
  email        String?       @unique
  pinHash      String
  // Huella HMAC del PIN (determinística, a diferencia de pinHash que va
  // salado). Permite encontrar al usuario por PIN con una consulta indexada
  // en vez de comparar con bcrypt contra todos los usuarios uno por uno.
  // Nullable porque las cuentas creadas antes de este campo se migran solas
  // (ver lib/pin.ts) la primera vez que inician sesión después del cambio.
  pinLookup    String?       @unique
  rol          Rol
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  colaborador  Colaborador?
  asignaciones AsignacionTH[]
  credencialesBiometricas CredencialBiometrica[]
  registrosAcceso RegistroAcceso[]
  suscripcionesPush PushSubscription[]

  // Si tiene valor, cualquier sesión (token JWT) emitida ANTES de este
  // momento se considera inválida — es lo que usa "Cerrar sesión" del
  // Super Admin para forzar el cierre de una sesión ajena sin esperar a
  // que expire sola. getSession() la compara contra el "iat" del token.
  sesionesRevocadasEn DateTime?

  @@index([rol])
}

// Passkey (WebAuthn) registrada en un dispositivo del usuario, para
// login biométrico (Face ID / Touch ID / Windows Hello / huella).
// Complementa al PIN, nunca lo reemplaza.
model CredencialBiometrica {
  id           String    @id @default(cuid())
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId    String

  // Identificador de la credencial que devuelve el navegador (base64url)
  credentialId String    @unique
  // Clave pública en formato COSE, codificada en base64url
  publicKey    String
  // Contador de firmas del autenticador; si llega uno menor al guardado,
  // es señal de clonación y se debe rechazar el login.
  contador     Int       @default(0)
  dispositivo  String?   // nombre amigable, ej. "iPhone de Miguel"

  creadoEn     DateTime  @default(now())
  ultimoUso    DateTime?

  // Evita guardar el mismo equipo dos veces: algunos navegadores (Android/
  // Chrome con el gestor de contraseñas de Google, sobre todo) no siempre
  // respetan excludeCredentials y dejan crear una credencial nueva para un
  // dispositivo que ya la tenía. credentialId sí es único por sí solo, pero
  // eso no alcanza porque cada intento genera un id distinto.
  @@unique([usuarioId, dispositivo])
  @@index([usuarioId])
}

// Bitácora de logins exitosos (PIN o biometría) — no confundir con
// IntentoLogin, que solo cuenta intentos fallidos para el rate-limit y no
// identifica quién entró. Pensada para que Super Admin audite accesos:
// quién entró, cuándo, desde qué IP y con qué método.
model RegistroAcceso {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String
  metodo    String   // "PIN" | "BIOMETRIA"
  ip        String?
  userAgent String?
  creadoEn  DateTime @default(now())

  @@index([usuarioId, creadoEn])
  @@index([creadoEn])
}

// Suscripción a notificaciones push (Web Push) de un dispositivo/navegador
// puntual del usuario — puede tener varias (celular, compu, etc.). Se crea
// cuando acepta el permiso de notificaciones; se borra si el propio push
// service la reporta como vencida (endpoint ya no válido) o si el usuario
// la desactiva.
model PushSubscription {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String

  endpoint  String   @unique
  p256dh    String
  auth      String

  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}

model AsignacionTH {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String

  empresa   Empresa?         @relation(fields: [empresaId], references: [id])
  empresaId String?
  sitio     SitioProductivo? @relation(fields: [sitioId], references: [id])
  sitioId   String?
  area      Area?            @relation(fields: [areaId], references: [id])
  areaId    String?

  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model Colaborador {
  id             String            @id @default(cuid())
  numero         Int               @unique @default(autoincrement())
  usuario        Usuario           @relation(fields: [usuarioId], references: [id])
  usuarioId      String            @unique
  nombreCompleto String
  apellidos      String
  nombres        String
  // Código con el que el colaborador está registrado en nómina, para
  // poder cruzar los datos entre ambos sistemas. Nullable en el esquema
  // porque los colaboradores creados antes de este campo no tienen uno
  // todavía (se les puede agregar luego editándolos); el formulario de
  // "Nuevo colaborador" sí lo exige siempre.
  codigoNomina   String?           @unique
  fotoUrl        String?
  sitio          SitioProductivo   @relation(fields: [sitioId], references: [id])
  sitioId        String
  area           Area              @relation(fields: [areaId], references: [id])
  areaId         String

  rutaHabitualId String?
  rutaHabitual   Ruta?             @relation("RutaHabitual", fields: [rutaHabitualId], references: [id])
  rutasExclusivas Ruta[]           @relation("RutaExclusiva")

  esSupervisor   Boolean           @default(false)
  supervisorId   String?
  supervisor     Colaborador?      @relation("Equipo", fields: [supervisorId], references: [id])
  equipo         Colaborador[]     @relation("Equipo")

  estado         EstadoColaborador @default(ACTIVO)
  solicitudes    SolicitudPasaje[]
  createdAt      DateTime          @default(now())

  @@index([areaId])
  @@index([sitioId])
  @@index([supervisorId])
  @@index([areaId, estado])
  // Cubre el "equipo activo de un supervisor" que se pide en Mis Pasajes,
  // Historial, Copiar rutas y Asignar equipo.
  @@index([supervisorId, estado])
}

model SolicitudPasaje {
  id            String          @id @default(cuid())
  // Código corto (4 caracteres alfanuméricos, sin 0/O/1/I para no
  // confundirlos al leerlos) para identificar la solicitud sin tener que
  // describirla por nombre de ruta/fecha/colaborador.
  codigo        String          @unique
  colaborador   Colaborador     @relation(fields: [colaboradorId], references: [id])
  colaboradorId String

  ruta          Ruta            @relation(fields: [rutaId], references: [id])
  rutaId        String

  fecha         DateTime
  montoTotal    Decimal         @db.Decimal(10, 2)
  observaciones String?

  estado          EstadoSolicitud @default(PENDIENTE)
  fechaSolicitud  DateTime        @default(now())
  fechaAprobacion DateTime?
  fechaRevision   DateTime?
  fechaPago       DateTime?
  fechaRechazo    DateTime?
  aprobadoPorId   String?
  revisadoPorId   String?
  pagadoPorId     String?
  rechazadoPorId  String?
  comentario      String?

  creadoPorUsuarioId String?

  @@index([colaboradorId, estado])
  @@index([fecha])
  @@index([rutaId])
  @@index([estado, fecha])
}

// Contador de intentos de login fallidos por IP, para frenar fuerza bruta
// contra el PIN (6 dígitos = solo 1.000.000 de combinaciones). Vive en la
// base (no en memoria del proceso, ver lib/rateLimit.ts) para que el
// límite sea real en un entorno serverless (Vercel), donde cada instancia
// puede tener su propia memoria y reiniciarse en cualquier momento.
model IntentoLogin {
  clave   String   @id
  conteo  Int      @default(1)
  venceEn DateTime
}