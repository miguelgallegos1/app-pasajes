// ============================================================
// SCHEMA DE BASE DE DATOS - App de Gestión de Pasajes Corporativos
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  SUPER_ADMIN
  ADMIN_TH
  COLABORADOR
  FINANZAS
}

enum EstadoColaborador {
  ACTIVO
  INACTIVO
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
  PAGADA
}

model Empresa {
  id           String            @id @default(cuid())
  nombre       String
  ruc          String?           @unique
  activo       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  sitios       SitioProductivo[]
  rutas        Ruta[]
  asignaciones AsignacionTH[]
}

model SitioProductivo {
  id            String        @id @default(cuid())
  nombre        String
  direccion     String?
  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  empresaId     String
  areas         Area[]
  colaboradores Colaborador[]
  rutas         Ruta[]
  asignaciones  AsignacionTH[]

  @@index([empresaId])
}

model Area {
  id            String        @id @default(cuid())
  nombre        String
  sitio         SitioProductivo @relation(fields: [sitioId], references: [id])
  sitioId       String
  colaboradores Colaborador[]
  rutas         Ruta[]
  asignaciones  AsignacionTH[]

  @@index([sitioId])
}

model Ruta {
  id        String   @id @default(cuid())
  nombre    String   @default("Ruta sin nombre") // ej: "El Yaznán - Cayambe - Tabacundo"
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String
  sitio     SitioProductivo @relation(fields: [sitioId], references: [id])
  sitioId   String
  area      Area     @relation(fields: [areaId], references: [id])
  areaId    String
  valor     Decimal  @db.Decimal(10, 2)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  solicitudes SolicitudPasaje[]
  colaboradoresConEstaRutaHabitual Colaborador[] @relation("RutaHabitual")

  @@unique([areaId, nombre]) // evita 2 rutas con el mismo nombre en la misma área
  @@index([sitioId, areaId, activo])
}

model Usuario {
  id           String        @id @default(cuid())
  nombre       String
  email        String?       @unique
  pinHash      String
  // Huella HMAC del PIN (determinística, a diferencia de pinHash que va
  // salado). Permite encontrar al usuario por PIN con una consulta indexada
  // en vez de comparar con bcrypt contra todos los usuarios uno por uno.
  // Nullable porque las cuentas creadas antes de este campo se migran solas
  // (ver lib/pin.ts) la primera vez que inician sesión después del cambio.
  pinLookup    String?       @unique
  rol          Rol
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  colaborador  Colaborador?
  asignaciones AsignacionTH[]

  @@index([rol])
}

model AsignacionTH {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String

  empresa   Empresa?         @relation(fields: [empresaId], references: [id])
  empresaId String?
  sitio     SitioProductivo? @relation(fields: [sitioId], references: [id])
  sitioId   String?
  area      Area?            @relation(fields: [areaId], references: [id])
  areaId    String?

  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model Colaborador {
  id             String            @id @default(cuid())
  usuario        Usuario           @relation(fields: [usuarioId], references: [id])
  usuarioId      String            @unique
  nombreCompleto String
  apellidos      String
  nombres        String
  // Código con el que el colaborador está registrado en nómina, para
  // poder cruzar los datos entre ambos sistemas. Nullable en el esquema
  // porque los colaboradores creados antes de este campo no tienen uno
  // todavía (se les puede agregar luego editándolos); el formulario de
  // "Nuevo colaborador" sí lo exige siempre.
  codigoNomina   String?           @unique
  fotoUrl        String?
  sitio          SitioProductivo   @relation(fields: [sitioId], references: [id])
  sitioId        String
  area           Area              @relation(fields: [areaId], references: [id])
  areaId         String

  rutaHabitualId String?
  rutaHabitual   Ruta?             @relation("RutaHabitual", fields: [rutaHabitualId], references: [id])

  esSupervisor   Boolean           @default(false)
  supervisorId   String?
  supervisor     Colaborador?      @relation("Equipo", fields: [supervisorId], references: [id])
  equipo         Colaborador[]     @relation("Equipo")

  estado         EstadoColaborador @default(ACTIVO)
  solicitudes    SolicitudPasaje[]
  createdAt      DateTime          @default(now())

  @@index([areaId])
  @@index([sitioId])
  @@index([supervisorId])
  @@index([areaId, estado])
}

model SolicitudPasaje {
  id            String          @id @default(cuid())
  colaborador   Colaborador     @relation(fields: [colaboradorId], references: [id])
  colaboradorId String

  ruta          Ruta            @relation(fields: [rutaId], references: [id])
  rutaId        String

  fecha         DateTime
  montoTotal    Decimal         @db.Decimal(10, 2)
  observaciones String?

  estado          EstadoSolicitud @default(PENDIENTE)
  fechaSolicitud  DateTime        @default(now())
  fechaAprobacion DateTime?
  fechaPago       DateTime?
  aprobadoPorId   String?
  pagadoPorId     String?
  comentario      String?

  creadoPorUsuarioId String?

  @@index([colaboradorId, estado])
  @@index([fecha])
  @@index([rutaId])
  @@index([estado, fecha])
}